# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Calendar OAuth2 ────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# OAuth2 client (Web application)
# Local redirect URI:      http://localhost:3000/auth/callback
# Production redirect URI: https://YOUR-APP-DOMAIN/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://YOUR-APP-DOMAIN/auth/callback

# ── Gmail IMAP Polling ────────────────────────────────────────────────────────
# Use the dedicated Gmail account as GMAIL_USER.
# Use an App Password (not your real password): https://myaccount.google.com/apppasswords
# GMAIL_LABEL is optional — omit it (or set to INBOX) for a dedicated account
# where every incoming email should be processed.
GMAIL_USER=seanandnicoleskylight@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# GMAIL_LABEL=INBOX   ← default, can omit

# ── Inbound Webhook (optional) ────────────────────────────────────────────────
WEBHOOK_SECRET=your_random_webhook_secret

# ── App Settings ─────────────────────────────────────────────────────────────
PORT=3000
POLL_INTERVAL_MINUTES=5
DEFAULT_CALENDAR_ID=primary

# ── Storage (production) ──────────────────────────────────────────────────────
# Set by Railway/Render automatically via their volume mount path.
# Leave unset for local development.
# DATA_DIR=/var/data
